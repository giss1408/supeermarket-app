# Production environment. Copy to .env.prod and fill in. NEVER commit .env.prod.
# Values must not be quoted (docker compose passes them through literally).

# --- Django (required) ---
# Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
# Must be at least 32 characters; the development default is rejected.
SECRET_KEY=generate-one-with-the-command-above
# Postgres connection URL. Required; production never falls back to a default database.
# Managed Postgres: postgres://USER:PASSWORD@HOST:5432/NAME
# Bundled `with-db` profile: postgres://USER:PASSWORD@db:5432/NAME (same values as POSTGRES_* below)
DATABASE_URL=postgres://app:CHANGE_ME@db.example.com:5432/app
# Comma-separated host names this API answers to. Required; "*" is rejected.
# The FIRST entry is also the Host header used by the container health check.
ALLOWED_HOSTS=api.example.com
# Comma-separated origins (with scheme) trusted for CSRF on the admin. Optional.
CSRF_TRUSTED_ORIGINS=https://api.example.com
# Currency code shown by the API
CURRENCY=EUR
# Redirect plain HTTP to HTTPS (/healthz is always exempt). Leave 1.
SECURE_SSL_REDIRECT=1
# HSTS max-age in seconds (default one year). Lower it for the first deploy if unsure.
SECURE_HSTS_SECONDS=31536000
# Set to 1 only if EVERY subdomain of your domain is HTTPS-only.
SECURE_HSTS_INCLUDE_SUBDOMAINS=0
# Rate limit for the auth endpoints, e.g. 10/min
AUTH_THROTTLE_RATE=10/min

# --- Caddy (required) ---
# Public domain name; DNS must point at this server. Caddy obtains the certificate automatically.
DOMAIN=api.example.com
# Contact e-mail registered with Let's Encrypt
ACME_EMAIL=ops@example.com

# --- gunicorn ---
# Number of worker processes (default 3)
WEB_CONCURRENCY=3

# --- Logging and error reporting ---
# Log level written to stdout/stderr (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
# Sentry is initialized only when a DSN is set. Leave empty to disable.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
# Fraction of requests traced (0.0 to 1.0)
SENTRY_TRACES_SAMPLE_RATE=0.0

# --- Media storage ---
# Leave AWS_STORAGE_BUCKET_NAME empty to store uploads on the local `media` volume
# (then enable the /media/* block in deploy/Caddyfile).
AWS_STORAGE_BUCKET_NAME=
# S3-compatible endpoint (MinIO, R2, ...); empty for AWS S3
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=
# CDN/custom domain used to build public image URLs; optional
AWS_S3_CUSTOM_DOMAIN=
# Credentials (standard boto3 variables)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Bundled Postgres (only with `--profile with-db`) ---
POSTGRES_USER=app
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=app
