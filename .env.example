# Reference values for local development. Nothing loads this file automatically: export the
# variables you need in your shell (the defaults in config/settings/base.py already match them),
# or use `docker compose`, which sets them for the web service.

# Django
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=insecure-dev-only-key-change-me-0123456789abcdef
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://app:app@localhost:5434/app
CURRENCY=EUR

# Email (mailpit in dev)
EMAIL_HOST=localhost
EMAIL_PORT=1025

# Media storage (production). If AWS_STORAGE_BUCKET_NAME is unset, media is stored on local disk.
# S3-compatible bucket for uploaded images
AWS_STORAGE_BUCKET_NAME=
# Custom endpoint for S3-compatible providers (MinIO, R2, ...); optional
AWS_S3_ENDPOINT_URL=
# Bucket region; optional
AWS_S3_REGION_NAME=
# CDN/custom domain used to build public URLs; optional
AWS_S3_CUSTOM_DOMAIN=
# Credentials (standard boto3 variables; never commit real values)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
