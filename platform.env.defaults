# Settings of the platform deployment that are not secrets. `infra/scripts/make-product-env.sh supermarket .env.platform --defaults platform.env.defaults`
# merges them with infra/secrets/supermarket.env (database, redis, public host) and generated secrets (`@random`, created once and kept).
# ${...} is expanded from those files and from URL_SCHEME, PORT_SUFFIX, SERVICE_KEY (this product's key in the auth service).
#
# STAGING SETUP. For production change, deliberately:
#   SECURE_SSL_REDIRECT=1, COOKIES_SECURE=1 (or delete the line) and SECURE_HSTS_SECONDS=31536000 (after HTTPS is verified), NUM_PROXIES=2 (Cloudflare + Caddy),
#   CSRF_TRUSTED_ORIGINS=https://supermarket-api.regisse.com, SENTRY_DSN, the R2 bucket (AWS_* below), and NO demo passwords anywhere.

# Sign-in through the platform auth service (SSO), like flariane and fidelia: phone + password at auth, WhatsApp activation by the team,
# authenticator code for platform admins. The app's own e-mail register/login endpoints are switched off.
SSO_ENABLED=1
SSO_ISSUER=${URL_SCHEME}auth-api.${DOMAIN}${PORT_SUFFIX}
SSO_JWKS_URL=http://auth-web:8000/.well-known/jwks.json
SSO_AUTH_URL=http://auth-web:8000
SSO_SERVICE_KEY=${SERVICE_KEY}
SSO_MONEY_FAIL_CLOSED=1
LEGACY_AUTH_ENABLED=0

DJANGO_SETTINGS_MODULE=config.settings.prod
SECRET_KEY=@random
# Bearer token for GET /metrics (scraped by the platform monitoring agent as SUPERMARKET_METRICS_TOKEN; Caddy never routes /metrics)
METRICS_TOKEN=@random
# supermarket-web: the name the monitoring agent scrapes /metrics under, inside the private network (Caddy never routes that Host)
ALLOWED_HOSTS=${PUBLIC_HOST},supermarket-web
CSRF_TRUSTED_ORIGINS=${URL_SCHEME}${PUBLIC_HOST}${PORT_SUFFIX}
CURRENCY=XOF
LOG_LEVEL=INFO
WEB_CONCURRENCY=2
SECURE_SSL_REDIRECT=0
COOKIES_SECURE=0
SECURE_HSTS_SECONDS=3600
NUM_PROXIES=1
AUTH_THROTTLE_RATE=10/min
STAFF_SENSITIVE_THROTTLE_RATE=5/min
SENTRY_ENVIRONMENT=staging
# Media: R2 (S3-compatible) when AWS_STORAGE_BUCKET_NAME is set, else the local `media` volume
# AWS_STORAGE_BUCKET_NAME=supermarket-media
# AWS_S3_ENDPOINT_URL=https://<account>.r2.cloudflarestorage.com
# AWS_S3_CUSTOM_DOMAIN=media.regisse.com
